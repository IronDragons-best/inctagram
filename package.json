{
    "name": "inctagram",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --https --key=localhost-key.pem --cert=localhost.pem",
        "dev:https": "next dev -H front.nodewebdev.online -p 3000 --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem",
        "build": "next build",
        "build:production": "next build",
        "start": "next start",
        "test": "jest --passWithNoTests",
        "lint": "eslint \"src/**/*.{tsx,ts,jsx,js}\" && stylelint \"src/**/*.{scss,css}\" --allow-empty-input",
        "lint:fix": "eslint --fix \"src/**/*.{tsx,ts,jsx,js}\" && stylelint --fix \"src/**/*.{scss,css}\" --allow-empty-input",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "generate-api": "pnpm openapi-typescript https://nodewebdev.online/api/v1-json -o ./shared/schemas/api/schema.ts",
        "prepare": "husky"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.1.1",
        "@irondragons/ui-lib-inctagram": "^1.0.16",
        "@radix-ui/react-icons": "^1.3.2",
        "@reduxjs/toolkit": "^2.8.2",
        "async-mutex": "^0.5.0",
        "clsx": "^2.1.1",
        "cookie": "^1.0.2",
        "date-fns": "^4.1.0",
        "minimatch": "^10.0.3",
        "next": "15.3.4",
        "openapi-fetch": "^0.14.0",
        "prettier": "^3.6.2",
        "radix-ui": "^1.4.2",
        "react": "^19.0.0",
        "react-day-picker": "^9.8.1",
        "react-dom": "^19.0.0",
        "react-google-recaptcha": "^3.1.0",
        "react-hook-form": "^7.60.0",
        "react-redux": "^9.2.0",
        "sass": "^1.89.2",
        "stylelint": "^16.23.0",
        "swiper": "^11.2.10",
        "zod": "^3.25.74"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@it-incubator/prettier-config": "^0.1.2",
        "@it-incubator/stylelint-config": "^2.0.0",
        "@next/eslint-plugin-next": "^15.4.5",
        "@types/minimatch": "^6.0.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/react-google-recaptcha": "^2.1.9",
        "async-mutex": "^0.5.0",
        "eslint": "^9",
        "eslint-config-next": "15.3.4",
        "eslint-plugin-prettier": "^5.5.3",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "husky": "^9.1.7",
        "jest": "^30.0.2",
        "ldrs": "^1.1.7",
        "lint-staged": "^16.1.5",
        "openapi-typescript": "^7.8.0",
        "typescript": "^5"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "pnpm prettier --write",
            "pnpm eslint --fix"
        ]
    }
}
